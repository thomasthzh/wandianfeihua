# 万点飞花：脱敏拓扑清单。
# 这是手册的字段示例，不是可直接 source/部署的应用配置。
# 本仓库未包含可运行的桌面源码、构建产物或服务器二进制。
# 文档地址不能用于真实部署；填写后的私有副本不得提交到 Git。

EXAMPLE_ONLY=true
PROJECT_DISPLAY_NAME=万点飞花
DEPLOYMENT_OWNER_COUNT=1

# 唯一公开桌面与身份入口。回调路径必须与自己的 BFF 实现一致。
PUBLIC_ORIGIN=https://os.example.net
IDENTITY_ISSUER=https://auth.os.example.net
OIDC_REDIRECT_URI=https://os.example.net/auth/callback
OPERATOR_CONTACT=operator@example.net
LOGIN_POLICY=password_plus_totp

# 地址按角色登记；Tailnet 连通性不替代认证与授权。
CORE_ROLE=core-v6
CORE_TAILNET_ADDRESS=100.64.0.10
CORE_PUBLIC_IPV6=2001:db8:120::10
CORE_PUBLIC_IPV6_POLICY=rediscover_and_verify_before_activation

EDGE_ROLE=edge-v4
EDGE_PUBLIC_IPV4=192.0.2.10
EDGE_LAN_IPV4=192.0.2.20
EDGE_TAILNET_ADDRESS=100.64.0.20
PRIVATE_GATEWAY_ALLOWED_ROLE=edge-v4

# IPv4 经边缘与 Tailnet 到核心；IPv6 直接到核心。
PUBLIC_IPV4_ROUTE=edge-v4_to_core-v6_over_tailnet
PUBLIC_IPV6_ROUTE=core-v6_direct
TLS_TERMINATION=both_public_entries
APPLICATION_REGISTRATION=default_deny
APPLICATION_NATIVE_AUTH=preserved

# 示例字段，不填真实 secret、用户 subject、SMTP 凭据、私钥或哈希。
# 独立应用来源只在逐项审查通过后设置；不能接受浏览器任意输入 URL。
APP_ORIGIN=__REQUIRED_AFTER_APPLICATION_REVIEW__
APP_CANONICAL_ORIGIN=__REQUIRED_FROM_DEPLOYMENT_EVIDENCE__
APP_TRANSPORT_TARGET=__REQUIRED_FROM_AUTHORIZED_INVENTORY__
OWNER_SUBJECT=__SET_PRIVATELY_IN_SERVER_CONFIGURATION__
OIDC_CLIENT_SECRET_SOURCE=__PRIVATE_SERVER_FILE_REQUIRED__
SMTP_CONFIGURATION=__PRIVATE_CONFIGURATION_AND_DELIVERY_TEST_REQUIRED__
DNS_TOKEN_SOURCE=__PRIVATE_ZONE_SCOPED_CREDENTIAL_REQUIRED__

# 本次验证基线；不是“永远最新”的版本声明。
VALIDATED_CORE_CADDY_VERSION=2.11.7
VALIDATED_EDGE_CADDY_VERSION=2.11.4
VALIDATED_AUTHELIA_VERSION=4.39.28

# 下列字段说明发布门槛，不会触发动作，也不是公网验收报告。
ACTIVATION_REQUIRES=four_stage_validation_and_explicit_release_selection
PUBLIC_ACCEPTANCE_REQUIRED=ipv4_ipv6_mfa_smtp_logout_and_each_application
NODE_WRITE_OPERATIONS=disabled_until_implemented_and_accepted
FILE_WRITE_OPERATIONS=disabled_until_implemented_and_accepted
TASK_EXECUTION=disabled_until_implemented_and_accepted
AUTO_RENEWAL=requires_separate_installation_and_acceptance
